<Window x:Class="Epub3MediaOverlays.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Settings" Height="500" Width="750" WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Grid>
        <ui:NavigationView x:Name="SettingsNav" PaneDisplayMode="Left" SelectionChanged="SettingsNav_SelectionChanged">
            <ScrollViewer Margin="20">
                <StackPanel>
                    <ItemsControl x:Name="SettingsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:SimpleStackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <ContentControl Content="{Binding EditorControl}"/>
                                    <Separator Margin="0,15,0,0" Opacity="0.2"/>
                                </ui:SimpleStackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <!--<Button Content="Delete All" Click="DeleteSettings_Click" Margin="0,0,10,0"/>-->
                        <Button Content="Save &amp; Restart" Click="Save_Click" Margin="0,0,10,0"/>
                        <Button Content="Cancel" Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ui:NavigationView>
    </Grid>
</Window>

