<Window x:Class="Epub3MediaOverlays.Wpf.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Epub3MediaOverlays.Wpf"
        Title="Alignment Log Viewer" Height="700" Width="1000">
    <Window.Resources>
        <Style x:Key="TreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with metadata -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10">
            <StackPanel Orientation="Vertical">
                <TextBlock FontWeight="Bold" FontSize="14">Alignment Log Tree Viewer</TextBlock>
                <TextBlock Margin="0,5,0,0" Foreground="Gray" Text="{Binding LogTree.Duration, StringFormat='Duration: {0:mm\\:ss\\.fff}'}"/>
                <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="{Binding LogTree.TotalNodeCount, StringFormat='Total nodes: {0}'}"/>
            </StackPanel>
        </Border>

        <!-- Main split view: Tree on left, Details on right -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: Tree view -->
            <ScrollViewer Grid.Column="0">
                <TreeView ItemsSource="{Binding RootNodes}" x:Name="TreeViewControl">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <!-- Node Header -->
                            <Border Padding="8" Margin="2" CornerRadius="3" BorderThickness="2">
                                <Border.Background>
                                    <SolidColorBrush>
                                        <SolidColorBrush.Color>
                                            <MultiBinding Converter="{StaticResource StatusToBrushConverter}">
                                                <Binding Path="Node.Status"/>
                                            </MultiBinding>
                                        </SolidColorBrush.Color>
                                    </SolidColorBrush>
                                </Border.Background>

                                <StackPanel Orientation="Vertical">
                                    <!-- Status and Coordinates -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Foreground="White" Text="{Binding StatusLabel}" MinWidth="80"/>
                                        <TextBlock Margin="10,0,0,0" Foreground="White" Text="{Binding CoordinateSummary}" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Node Type -->
                                    <TextBlock Margin="0,3,0,0" Foreground="WhiteSmoke" FontSize="10" Text="{Binding NodeTypeSummary}"/>

                                    <!-- Gap Summary (if any) -->
                                    <TextBlock Margin="0,3,0,0" Foreground="White" FontSize="10" 
                                               Text="{Binding GapSummary}" 
                                               Visibility="{Binding HasGaps, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Error Message (if failed) -->
                                    <TextBlock Margin="0,3,0,0" Foreground="White" FontSize="10" 
                                               Text="{Binding ErrorMessage}"/>

                                    <!-- Details Row -->
                                    <TextBlock Margin="0,3,0,0" Foreground="WhiteSmoke" FontSize="9" Text="{Binding DetailsSummary}"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource TreeItemStyle}">
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </ScrollViewer>

            <!-- Vertical separator -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD" ShowsPreview="True"/>

            <!-- Right pane: Details (tree info or fragment view) -->
            <Border Grid.Column="2" Background="White" BorderThickness="1" BorderBrush="LightGray">
                <ContentControl x:Name="DetailsPanel" Content="{Binding}" 
                                Loaded="DetailsPanel_Loaded" MouseDown="TreeView_SelectionChanged"/>
            </Border>
        </Grid>

        <!-- Footer with legend -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="Gray">Legend:</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <Border Background="Green" Width="15" Height="15" CornerRadius="2" Margin="0,0,5,0"/>
                    <TextBlock FontSize="10" Text="Success" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Border Background="Orange" Width="15" Height="15" CornerRadius="2" Margin="0,0,5,0"/>
                    <TextBlock FontSize="10" Text="Partial (has gaps)" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Border Background="Red" Width="15" Height="15" CornerRadius="2" Margin="0,0,5,0"/>
                    <TextBlock FontSize="10" Text="Failed" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Border Background="LightBlue" Width="15" Height="15" CornerRadius="2" Margin="0,0,5,0"/>
                    <TextBlock FontSize="10" Text="Split" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

